import {
  "broti/mrtkit" @mrt,
  "moonbitlang/core/json",
}

pkgtype(kind: "foreign_library")

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "configure",
        "consume",
        "finish",
        "reset_file",
        "begin_baseline",
        "end_baseline",
        "consume_at",
        "csv_header",
        "state",
        "canonical_prefix",
        "decode_record",
        "consume_metrics",
        "stream_reset",
        "stream_metrics",
        "stream_end",
        "snapshot_begin",
        "snapshot_consume",
        "snapshot_finish",
      ],
      "format": "esm",
    },
  },
)
