import {
  "prowk/mrtkit" @mrt,
  "moonbitlang/core/json",
}

pkgtype(kind: "foreign_library")

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "configure",
        "correlation_key_from_json",
        "correlation_semantics_from_json",
        "consume",
        "finish",
        "reset_file",
        "begin_baseline",
        "end_baseline",
        "consume_at",
        "consume_selected",
        "consume_selected_metrics",
        "partition_record",
        "path_totals",
        "route_count",
        "csv_header",
        "state",
        "canonical_prefix",
        "decode_record",
        "consume_metrics",
        "drain_changes",
        "storage_stats",
        "state_export_begin",
        "state_export_chunk",
        "stream_reset",
        "stream_metrics",
        "stream_end",
        "snapshot_begin",
        "snapshot_consume",
        "snapshot_finish",
      ],
      "format": "esm",
    },
  },
)
